<Window x:Class="UsbPulse.SettingsWindow"
        xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="using:FluentAvalonia.UI.Controls"
        Title="UsbPulse · 外观设置" Width="440" SizeToContent="Height"
        CanResize="False" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
  <StackPanel Margin="24,20" Spacing="20">
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,2">
      <TextBlock Text="外观" FontSize="22" FontWeight="SemiBold" />
      <fa:SymbolIcon Grid.Column="1" Symbol="ColorFill" FontSize="24"
                     Foreground="{DynamicResource UsbAccentBrush}" />
    </Grid>
    <StackPanel Spacing="8">
      <TextBlock Text="主题" FontWeight="SemiBold" />
      <ComboBox x:Name="ThemeBox" HorizontalAlignment="Stretch" AutomationProperties.Name="主题">
        <ComboBoxItem Content="跟随系统" />
        <ComboBoxItem Content="浅色" />
        <ComboBoxItem Content="深色" />
      </ComboBox>
    </StackPanel>
    <StackPanel Spacing="12">
      <TextBlock Text="强调色" FontWeight="SemiBold" />
      <UniformGrid x:Name="Swatches" Columns="3" Rows="2" />
    </StackPanel>
    <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
    <ToggleSwitch x:Name="TopmostSwitch" Content="窗口置顶" OnContent="开启" OffContent="关闭"
                  AutomationProperties.Name="窗口置顶" />
    <StackPanel x:Name="WindowsEffectsPanel" Spacing="12">
      <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
      <TextBlock Text="Windows 渲染" FontWeight="SemiBold" />
      <ToggleSwitch x:Name="AcrylicSwitch" Content="亚克力背景" OnContent="开启" OffContent="关闭"
                    AutomationProperties.Name="亚克力背景" />
      <ToggleSwitch x:Name="HighRefreshSwitch" Content="高刷新率合成" OnContent="开启" OffContent="关闭"
                    AutomationProperties.Name="高刷新率合成" />
    </StackPanel>
    <fa:InfoBar x:Name="RestartInfo" IsOpen="False" IsClosable="False" Severity="Informational"
                Message="渲染设置将在重启后生效。">
      <fa:InfoBar.ActionButton>
        <Button Content="立即重启" Click="RestartClick" />
      </fa:InfoBar.ActionButton>
    </fa:InfoBar>
    <fa:InfoBar x:Name="SettingsError" IsOpen="False" IsClosable="True" Severity="Error" />
    <TextBlock Text="UsbPulse 0.2.0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
  </StackPanel>
</Window>
