<Window x:Class="UsbPulse.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="using:FluentAvalonia.UI.Controls"
        xmlns:models="using:UsbPulse.Models"
        x:DataType="models:DeviceState"
        Title="UsbPulse" Width="344" SizeToContent="Height"
        CanResize="False" ShowInTaskbar="False" ShowActivated="False"
        SystemDecorations="None" Topmost="False"
        TransparencyLevelHint="Transparent" Background="Transparent">
  <Window.ContextMenu>
    <ContextMenu>
      <MenuItem Header="设置" Click="SettingsClick" />
      <MenuItem Header="刷新设备" Click="RefreshClick" />
    </ContextMenu>
  </Window.ContextMenu>
  <Window.Styles>
    <Style Selector="ProgressBar.space-usage.nearly-full">
      <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
    </Style>
  </Window.Styles>
  <LayoutTransformControl x:Name="CardScale">
  <Border x:Name="RootCard" Padding="12,10,12,8" CornerRadius="8"
          BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
    <StackPanel Spacing="8">
      <Grid ColumnDefinitions="*,Auto,28,28" ColumnSpacing="6">
        <TextBlock x:Name="DeviceNameText" Text="{Binding Detail}" FontSize="13" FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Detail}" VerticalAlignment="Center" />
        <TextBlock x:Name="CapacityText" Grid.Column="1" Text="{Binding Capacity}"
                   FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
        <Button x:Name="RefreshButton" Grid.Column="2" Classes="tool" Click="RefreshClick"
                Width="28" Height="28" IsEnabled="{Binding !Busy}" VerticalAlignment="Center"
                ToolTip.Tip="刷新设备" AutomationProperties.Name="刷新设备">
          <fa:SymbolIcon Symbol="Refresh" FontSize="16" />
        </Button>
        <Button x:Name="SettingsButton" Grid.Column="3" Classes="tool" Click="SettingsClick"
                Width="28" Height="28" VerticalAlignment="Center"
                ToolTip.Tip="设置" AutomationProperties.Name="设置">
          <fa:SymbolIcon Symbol="Settings" FontSize="16" />
        </Button>
      </Grid>
      <ComboBox x:Name="DevicePicker" ItemsSource="{Binding Devices}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                IsVisible="{Binding HasMultiple}" IsEnabled="{Binding !Busy}" HorizontalAlignment="Stretch"
                MinHeight="30" Padding="8,4" FontSize="12" AutomationProperties.Name="选择存储设备">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="models:StorageDevice">
            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <Border IsVisible="{Binding HasMessage}" Padding="8,6" CornerRadius="4"
              Background="{DynamicResource UsbAccentSoftBrush}">
        <TextBlock Text="{Binding Message}" FontSize="12" TextWrapping="Wrap" />
      </Border>
      <Border IsVisible="{Binding HasUsage}" Height="6" CornerRadius="3"
              Background="{DynamicResource UsbAccentSoftBrush}">
        <ProgressBar x:Name="SpaceUsage" Classes="space-usage" Classes.nearly-full="{Binding IsNearlyFull}"
                     IsVisible="{Binding HasUsage}" Minimum="0" Maximum="100" Value="{Binding UsedPercentage}"
                     Height="6" MinHeight="0" CornerRadius="3" BorderThickness="0" Padding="0"
                     Background="Transparent" ToolTip.Tip="{Binding UsageDescription}"
                     AutomationProperties.Name="空间占用" AutomationProperties.HelpText="{Binding UsageDescription}" />
      </Border>
      <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Height="36">
        <Button Grid.Column="0" Click="EjectClick" IsEnabled="{Binding CanEject}"
                HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0" CornerRadius="5">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <PathIcon Width="16" Height="16" VerticalAlignment="Center"
                      Data="M3,19 L21,19 L21,17 L3,17 Z M12,2 L5.5,12 L9.5,12 L9.5,15 L14.5,15 L14.5,12 L18.5,12 Z" />
            <TextBlock Text="{Binding EjectLabel}" FontSize="13" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Grid.Column="1" Click="OpenClick" IsEnabled="{Binding CanOpen}"
                HorizontalAlignment="Stretch" Background="{DynamicResource UsbAccentSoftBrush}"
                BorderThickness="0" CornerRadius="5">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <fa:SymbolIcon Symbol="OpenFolder" FontSize="16" VerticalAlignment="Center" />
            <TextBlock Text="打开" FontSize="13" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </StackPanel>
  </Border>
  </LayoutTransformControl>
</Window>
